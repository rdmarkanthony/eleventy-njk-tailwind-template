{
    "name": "eleventy-njk-tailwind-template",
    "version": "1.0.0",
    "type": "module",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "npm-run-all -s clean -p 'dev:*'",
        "dev:eleventy": "eleventy --serve",
        "dev:css": "tailwindcss -i ./src/assets/css/style.css -o ./public/assets/css/style.css --watch",
        "dev:js": "node esbuild.config.js --watch",
        "build": "npm-run-all -s clean 'build:*'",
        "build:eleventy": "eleventy",
        "build:css": "tailwindcss -i ./src/assets/css/style.css -o ./public/assets/css/style.css --minify",
        "build:js": "node esbuild.config.js",
        "clean": "node -e \"require('fs').rmSync('public', { recursive: true, force: true })\"",
        "test": "echo \"Error: no test specified\" && exit 1",
        "format": "prettier --write .",
        "preinstall": "npx only-allow pnpm"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.28.2",
    "dependencies": {
        "@11ty/eleventy": "^3.1.2"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.0",
        "dotenv": "^17.3.1",
        "esbuild": "^0.27.3",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.8.1",
        "prettier-plugin-jinja-template": "^2.1.0",
        "tailwindcss": "^4.2.0"
    }
}
